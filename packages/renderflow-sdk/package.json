{
  "name": "renderflow-sdk",
  "version": "0.1.0",
  "description": "SDK to send render events from your app to the Render Flow VS Code extension",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p . && node build-esm.mjs",
    "dev": "tsc -p . --watch",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "esbuild": "^0.24.0",
    "react": "^18.2.0",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "react": ">=17.0.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true }
  },
  "keywords": ["renderflow", "vscode", "react", "telemetry"]
}
